# Development Dockerfile for AI Video FTE API
FROM node:20-alpine

WORKDIR /app

# Install dependencies
COPY package.json package-lock.json* ./
RUN npm ci

# Copy source code
COPY src ./src
COPY config ./config
COPY tsconfig.json ./
COPY migrations ./migrations

# Expose ports
EXPOSE 3000 9090

# Run with tsx for hot reload
CMD ["npm", "run", "dev:api"]