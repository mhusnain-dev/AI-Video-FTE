{
  "dashboard": {
    "title": "AI Video FTE - Rate Limiting & Webhook Monitoring",
    "uid": "ai-video-fte-ratelimit-webhook",
    "tags": ["ai-video-fte", "rate-limit", "webhook", "watchdog", "provider-health"],
    "timezone": "utc",
    "panels": [
      {
        "id": 1,
        "title": "Rate Limit Exceeded by Scope",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(ai_video_rate_limit_exceeded_total[5m]) * 60",
            "legendFormat": "{{scope}} model={{model_id}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 2,
        "title": "Rate Limit Usage by Scope",
        "type": "timeseries",
        "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "ai_video_rate_limit_usage_gauge",
            "legendFormat": "{{scope_type}}:{{scope_key}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 3,
        "title": "Webhook Health by Provider",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(ai_video_webhook_received_total{status=\"completed\"}[5m]) * 60",
            "legendFormat": "{{provider}} completed",
            "refId": "A"
          },
          {
            "expr": "rate(ai_video_webhook_received_total{status=\"failed\"}[5m]) * 60",
            "legendFormat": "{{provider}} failed",
            "refId": "B"
          }
        ]
      },
      {
        "id": 4,
        "title": "Webhook Latency by Provider (P95)",
        "type": "timeseries",
        "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(ai_video_webhook_processing_latency_seconds_bucket[5m])) by (le, provider))",
            "legendFormat": "P95 {{provider}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {"defaults": {"unit": "s"}}
      },
      {
        "id": 5,
        "title": "Unrecognized Webhooks",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(ai_video_webhook_unrecognized_total[5m]) * 60",
            "legendFormat": "{{provider}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 6,
        "title": "Watchdog Stuck Dispatches",
        "type": "timeseries",
        "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "ai_video_watchdog_stuck_dispatches_gauge",
            "legendFormat": "{{model_id}} {{status}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 7,
        "title": "Provider Success Rate",
        "type": "stat",
        "gridPos": {"x": 0, "y": 24, "w": 8, "h": 8},
        "targets": [
          {
            "expr": "sum(rate(ai_video_webhook_received_total{status=\"completed\"}[5m])) by (provider) / sum(rate(ai_video_webhook_received_total[5m])) by (provider)",
            "legendFormat": "{{provider}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "red", "value": null},
                {"color": "yellow", "value": 0.95},
                {"color": "green", "value": 0.99}
              ]
            }
          }
        }
      },
      {
        "id": 8,
        "title": "Duplicate Webhooks",
        "type": "timeseries",
        "gridPos": {"x": 8, "y": 24, "w": 8, "h": 8},
        "targets": [
          {
            "expr": "rate(ai_video_webhook_received_total{duplicate=\"true\"}[5m]) * 60",
            "legendFormat": "{{provider}}",
            "refId": "A"
          }
        ]
      }
    ],
    "time": {"from": "now-1h", "to": "now"},
    "refresh": "10s"
  }
}