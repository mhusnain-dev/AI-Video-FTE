{
  "dashboard": {
    "title": "AI Video FTE - Face-Lock Verification",
    "uid": "ai-video-fte-facelock",
    "tags": ["ai-video-fte", "facelock", "verification", "identity", "consistency"],
    "timezone": "utc",
    "panels": [
      {
        "id": 1,
        "title": "Face-Lock Verification Results",
        "type": "piechart",
        "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "sum by (result) (ai_video_facelock_verification_total)",
            "legendFormat": "{{result}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 2,
        "title": "Verification Rate by Character & Model",
        "type": "timeseries",
        "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(ai_video_facelock_verification_total[5m]) * 60",
            "legendFormat": "{{character_name}} {{model_id}} {{result}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 3,
        "title": "Similarity Score Distribution (P50, P95, P99)",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.50, sum(rate(ai_video_facelock_similarity_score_bucket[5m])) by (le, character_name, model_id))",
            "legendFormat": "P50 {{character_name}} {{model_id}}",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, sum(rate(ai_video_facelock_similarity_score_bucket[5m])) by (le, character_name, model_id))",
            "legendFormat": "P95 {{character_name}} {{model_id}}",
            "refId": "B"
          },
          {
            "expr": "histogram_quantile(0.99, sum(rate(ai_video_facelock_similarity_score_bucket[5m])) by (le, character_name, model_id))",
            "legendFormat": "P99 {{character_name}} {{model_id}}",
            "refId": "C"
          }
        ],
        "fieldConfig": {"defaults": {"unit": "short", "min": 0, "max": 1}}
      },
      {
        "id": 4,
        "title": "Auto-Regenerations",
        "type": "timeseries",
        "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(ai_video_facelock_regeneration_total[5m]) * 60",
            "legendFormat": "{{shot_id}} retry={{retry_count}} ({{trigger}})",
            "refId": "A"
          }
        ]
      },
      {
        "id": 5,
        "title": "Max Retries Exceeded",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(ai_video_facelock_max_retries_exceeded_total[5m]) * 60",
            "legendFormat": "{{character_name}} {{model_id}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 6,
        "title": "Cross-Shot Drift Detected",
        "type": "timeseries",
        "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(ai_video_facelock_cross_shot_drift_detected_total[5m]) * 60",
            "legendFormat": "{{character_name}} {{story_id}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 7,
        "title": "Consistency Reports Generated",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 24, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(ai_video_facelock_consistency_report_generated_total[5m]) * 60",
            "legendFormat": "{{story_id}} passed={{overall_passed}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 8,
        "title": "Face-Lock Pass Rate",
        "type": "gauge",
        "gridPos": {"x": 12, "y": 24, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "ai_video_facelock_pass_rate_gauge",
            "legendFormat": "{{character_name}} {{model_id}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "max": 1,
            "unit": "percentunit",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "red", "value": null},
                {"color": "yellow", "value": 0.8},
                {"color": "green", "value": 0.95}
              ]
            }
          }
        }
      }
    ],
    "time": {"from": "now-1h", "to": "now"},
    "refresh": "10s"
  }
}