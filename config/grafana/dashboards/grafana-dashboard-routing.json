{
  "dashboard": {
    "title": "AI Video FTE - Routing & Model Selection",
    "uid": "ai-video-fte-routing",
    "tags": ["ai-video-fte", "routing", "models"],
    "timezone": "utc",
    "panels": [
      {
        "id": 1,
        "title": "Model Selection Distribution",
        "type": "piechart",
        "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "sum by (model_id, reason) (ai_video_model_selection_total)",
            "legendFormat": "{{model_id}} ({{reason}})",
            "refId": "A"
          }
        ]
      },
      {
        "id": 2,
        "title": "Model Selections Rate",
        "type": "timeseries",
        "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(ai_video_model_selection_total[5m]) * 60",
            "legendFormat": "{{model_id}} override={{is_override}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 3,
        "title": "Models Filtered by Eligibility",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(ai_video_model_eligibility_filtered_total[5m]) * 60",
            "legendFormat": "{{model_id}} ({{reason}})",
            "refId": "A"
          }
        ]
      },
      {
        "id": 4,
        "title": "Model Fallbacks",
        "type": "timeseries",
        "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(ai_video_model_fallback_total[5m]) * 60",
            "legendFormat": "{{from_model}} -> {{to_model}} ({{reason}})",
            "refId": "A"
          }
        ]
      },
      {
        "id": 5,
        "title": "Model Registry Refresh Status",
        "type": "stat",
        "gridPos": {"x": 0, "y": 16, "w": 8, "h": 4},
        "targets": [
          {
            "expr": "rate(ai_video_model_registry_refresh_total{success=\"true\"}[5m]) * 60",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps"
          }
        }
      },
      {
        "id": 6,
        "title": "Registry Refresh Failures",
        "type": "stat",
        "gridPos": {"x": 8, "y": 16, "w": 8, "h": 4},
        "targets": [
          {
            "expr": "rate(ai_video_model_registry_refresh_total{success=\"false\"}[5m]) * 60",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "red", "value": 0.1}
              ]
            }
          }
        }
      }
    ],
    "time": {"from": "now-1h", "to": "now"},
    "refresh": "10s"
  }
}