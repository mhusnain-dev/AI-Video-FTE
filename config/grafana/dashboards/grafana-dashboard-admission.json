{
  "dashboard": {
    "title": "AI Video FTE - Admission Control",
    "uid": "ai-video-fte-admission",
    "tags": ["ai-video-fte", "admission", "moderation", "sacred-guard", "cost-guard", "rate-limit"],
    "timezone": "utc",
    "panels": [
      {
        "id": 1,
        "title": "Admission Pipeline Latency (P50, P95, P99)",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.50, sum(rate(ai_video_admission_pipeline_duration_seconds_bucket[5m])) by (le, gate, result))",
            "legendFormat": "P50 {{gate}} {{result}}",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, sum(rate(ai_video_admission_pipeline_duration_seconds_bucket[5m])) by (le, gate, result))",
            "legendFormat": "P95 {{gate}} {{result}}",
            "refId": "B"
          },
          {
            "expr": "histogram_quantile(0.99, sum(rate(ai_video_admission_pipeline_duration_seconds_bucket[5m])) by (le, gate, result))",
            "legendFormat": "P99 {{gate}} {{result}}",
            "refId": "C"
          }
        ],
        "fieldConfig": {"defaults": {"unit": "s"}}
      },
      {
        "id": 2,
        "title": "Gate Decisions",
        "type": "timeseries",
        "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(ai_video_admission_gate_decision_total[5m]) * 60",
            "legendFormat": "{{gate}} {{decision}} ({{reason_category}})",
            "refId": "A"
          }
        ]
      },
      {
        "id": 3,
        "title": "Sacred Guard Blocks by Enforcement Point",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(ai_video_sacred_guard_block_total[5m]) * 60",
            "legendFormat": "{{enforcement_point}} ({{match_type}}) model={{model_id}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 4,
        "title": "Cost Guard Pauses",
        "type": "timeseries",
        "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(ai_video_cost_guard_pause_total[5m]) * 60",
            "legendFormat": "{{reason}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 5,
        "title": "Rate Limit Exceeded",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(ai_video_rate_limit_exceeded_total[5m]) * 60",
            "legendFormat": "{{scope}} model={{model_id}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 6,
        "title": "Rate Limit Usage Gauge",
        "type": "gauge",
        "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "ai_video_rate_limit_usage_gauge",
            "legendFormat": "{{scope_type}}:{{scope_key}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "max": 100,
            "unit": "percentunit",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 70},
                {"color": "red", "value": 90}
              ]
            }
          }
        }
      },
      {
        "id": 7,
        "title": "Admission Audit Write Latency",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 24, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.99, sum(rate(ai_video_admission_audit_write_duration_seconds_bucket[5m])) by (le, gate))",
            "legendFormat": "P99 {{gate}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {"defaults": {"unit": "s"}}
      }
    ],
    "time": {"from": "now-1h", "to": "now"},
    "refresh": "10s"
  }
}