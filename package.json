{
  "name": "ai-video-fte",
  "version": "0.1.0",
  "description": "AI Video Production Specialist Digital FTE",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "jest --coverage",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --testPathPattern=tests/integration",
    "test:contract": "jest --testPathPattern=tests/contract",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "migrate": "node migrations/run.js",
    "dev": "concurrently -k -n API,FE,DB 'npm run dev:api' 'npm run dev:frontend' 'npm run dev:docker'",
    "dev:api": "tsx scripts/wait-for-services.ts && tsx src/main.ts",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:docker": "docker compose -f docker-compose.dev.yaml up",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1105.0",
    "@google-cloud/storage": "^5.18.3",
    "@google/generative-ai": "^0.24.1",
    "axios": "^1.6.5",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.2",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.3",
    "node-vault": "^0.10.0",
    "nodemailer": "^9.0.5",
    "onnxruntime-web": "^1.27.0",
    "pg": "^8.11.3",
    "pgvector": "^0.1.7",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "prom-client": "^15.1.3",
    "uuid": "^9.0.1",
    "yaml": "^2.3.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-validator": "^2.20.33",
    "@types/fluent-ffmpeg": "^2.1.24",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.10.6",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.10.9",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nock": "^13.4.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.11",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
